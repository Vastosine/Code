7ad9\u6570\u3001\u6bcf\u4e2a\u5730\u94c1\u7ad9\u6700\u591a\u88ab\u51e0\u6761\u7ebf\u8def\u7ecf\u8fc7\uff0c\u4ee5\u53ca\u51fa\u884c\u8ba1\u5212\u6570\u3002\u7279\u522b\u5730\uff0c\u82e5 $c=0$\uff0c\u5219\u8be5\u6d4b\u8bd5\u70b9\u4e3a\u6837\u4f8b\u3002\n\n\u8f93\u5165\u7684\u7b2c\u4e8c\u884c\u5305\u542b $m$ \u4e2a\u6b63\u6574\u6570 $w_1,w_2,\\ldots,w_m$\uff0c\u4f9d\u6b21\u8868\u793a\u4ece\u6bcf\u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\u8d70\u5230\u7ad9\u5385\u9700\u8981\u7684\u65f6\u95f4\u3002\n\n\u8f93\u5165\u7684\u7b2c $i+2$\uff08$1 \\le i \\le n$\uff09\u884c\u5305\u542b $1+2k_i$ \u4e2a\u6b63\u6574\u6570\uff0c\u5176\u4e2d\u7b2c\u4e00\u4e2a\u6b63\u6574\u6570\u4e3a $k_i$\uff0c\u8868\u793a\u7b2c $i$ \u6761\u7ebf\u8def\u7ecf\u8fc7\u7684\u5730\u94c1\u7ad9\u6570\uff1b\u63a5\u4e0b\u6765 $2k_i$ \u4e2a\u6b63\u6574\u6570\u4e3a $a_{i,1},t_{i,1},a_{i,2},t_{i,2},\\ldots,a_{i,k_i},t_{i,k_i}$\uff0c\u5176\u4e2d $a_{i,j}$ \u8868\u793a\u7b2c $i$ \u6761\u7ebf\u8def\u7ecf\u8fc7\u7684\u7b2c $j$ \u4e2a\u5730\u94c1\u7ad9\uff0c$t_{i,j}$ \u8868\u793a\u4ece\u8be5\u5730\u94c1\u7ad9\u7684\u7ad9\u5385\u8d70\u5230\u7b2c $i$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\u9700\u8981\u7684\u65f6\u95f4\u3002\n\n\u8f93\u5165\u7684\u7b2c $r+n+2$\uff08$1 \\le r \\le q$\uff09\u884c\u5305\u542b\u4e24\u4e2a\u6b63\u6574\u6570 $x_r,y_r$\uff0c\u5206\u522b\u8868\u793a\u7b2c $r$ \u4e2a\u51fa\u884c\u8ba1\u5212\u7684\u8d77\u70b9\u548c\u7ec8\u70b9\u6240\u5728\u7684\u5730\u94c1\u7ad9\u7f16\u53f7\u3002","formatO":"\u8f93\u51fa\u5230\u6587\u4ef6 `subway.out` \u4e2d\u3002\n\n\u8f93\u51fa $q$ \u884c\uff0c\u5176\u4e2d\u7b2c $r$\uff08$1 \\le r \\le q$\uff09\u884c\u5305\u542b\u4e00\u4e2a\u975e\u8d1f\u6574\u6570\uff0c\u8868\u793a\u7b2c $r$ \u4e2a\u51fa\u884c\u8ba1\u5212\u7684\u6700\u5c0f\u603b\u6b65\u884c\u65f6\u95f4\u3002","hint":"### \u6837\u4f8b 1 \u89e3\u91ca\n\nB \u5e02\u6709 $5$ \u4e2a\u5730\u94c1\u7ad9\uff0c\u4ece\u5404\u5730\u94c1\u53e3\u8d70\u5230\u7ad9\u5385\u9700\u8981\u7684\u65f6\u95f4\u5206\u522b\u4e3a $4,1,9,2,5$\u3002\n\nB \u5e02\u6709 $2$ \u6761\u5730\u94c1\u7ebf\u8def\uff0c\u5176\u4e2d\u7b2c $1$ \u6761\u7ebf\u8def\u4f9d\u6b21\u7ecf\u8fc7\u7b2c $1,2,4$ \u4e2a\u5730\u94c1\u7ad9\uff0c\u7b2c $2$ \u6761\u7ebf\u8def\u4f9d\u6b21\u7ecf\u8fc7\u7b2c $2,3,5$ \u4e2a\u5730\u94c1\u7ad9\uff0c\u4e24\u6761\u7ebf\u8def\u5728\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\u76f8\u4ea4\u3002\n\n\u5bf9\u4e8e\u7b2c $1$ \u4e2a\u51fa\u884c\u8ba1\u5212\uff0c\u5c0f R \u5c06\u4ece\u7b2c $1$ \u4e2a\u5730\u94c1\u7ad9\u524d\u5f80\u7b2c $3$ \u4e2a\u5730\u94c1\u7ad9\uff1a\u4ed6\u53ef\u4ee5\u5148\u4ece\u7b2c $1$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\u8d70\u5230\u7ad9\u5385\uff0c\u518d\u8d70\u5230\u7b2c $1$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\uff0c\u4e58\u5750\u7b2c $1$ \u6761\u7ebf\u8def\u5230\u8fbe\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\u540e\u8d70\u56de\u7ad9\u5385\uff0c\u518d\u8d70\u5230\u7b2c $2$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\uff0c\u4e58\u5750\u7b2c $2$ \u6761\u7ebf\u8def\u5230\u8fbe\u7b2c $3$ \u4e2a\u5730\u94c1\u7ad9\u540e\u8d70\u56de\u7ad9\u5385\uff0c\u6700\u540e\u8d70\u5230\u7b2c $3$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\uff0c\u603b\u6b65\u884c\u65f6\u95f4\u4e3a\n\n$$\nw_1+t_{1,1}+(t_{1,2}+t_{2,1})+t_{2,2}+w_3=4+5+(7+3)+4+9=32.\n$$\n\n\u5bf9\u4e8e\u7b2c $2$ \u4e2a\u51fa\u884c\u8ba1\u5212\uff0c\u5c0f R \u5c06\u4ece\u7b2c $1$ \u4e2a\u5730\u94c1\u7ad9\u524d\u5f80\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\uff1a\u4ed6\u53ef\u4ee5\u5148\u4ece\u7b2c $1$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\u8d70\u5230\u7ad9\u5385\uff0c\u518d\u8d70\u5230\u7b2c $1$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\uff0c\u4e58\u5750\u7b2c $1$ \u6761\u7ebf\u8def\u5230\u8fbe\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\u540e\u8d70\u56de\u7ad9\u5385\uff0c\u6700\u540e\u8d70\u5230\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\uff0c\u603b\u6b65\u884c\u65f6\u95f4\u4e3a\n\n$$\nw_1+t_{1,1}+t_{1,2}+w_2=4+5+7+1=17.\n$$\n\n### \u6837\u4f8b 2 \u89e3\u91ca\n\nB \u5e02\u6709 $7$ \u4e2a\u5730\u94c1\u7ad9\u4e0e $3$ \u6761\u5730\u94c1\u7ebf\u8def\uff0c\u5176\u4e2d\u7b2c $1$ \u6761\u7ebf\u8def\u4f9d\u6b21\u7ecf\u8fc7\u7b2c $1,2,5$ \u4e2a\u5730\u94c1\u7ad9\uff0c\u7b2c $2$ \u6761\u7ebf\u8def\u4f9d\u6b21\u7ecf\u8fc7\u7b2c $2,3,7$ \u4e2a\u5730\u94c1\u7ad9\uff0c\u7b2c $3$ \u6761\u7ebf\u8def\u4f9d\u6b21\u7ecf\u8fc7\u7b2c $3,5,4,6$ \u4e2a\u5730\u94c1\u7ad9\u3002\n\n\u5bf9\u4e8e\u7b2c $1$ \u4e2a\u51fa\u884c\u8ba1\u5212\uff0c\u5c0f R \u5c06\u4ece\u7b2c $1$ \u4e2a\u5730\u94c1\u7ad9\u524d\u5f80\u7b2c $6$ \u4e2a\u5730\u94c1\u7ad9\uff1a\u4ed6\u53ef\u4ee5\u5148\u4ece\u7b2c $1$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\u8d70\u5230\u7ad9\u5385\uff0c\u518d\u8d70\u5230\u7b2c $1$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\uff0c\u4e58\u5750\u7b2c $1$ \u6761\u7ebf\u8def\u5230\u8fbe\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\u540e\u8d70\u56de\u7ad9\u5385\uff0c\u518d\u8d70\u5230\u7b2c $2$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\uff0c\u4e58\u5750\u7b2c $2$ \u6761\u7ebf\u8def\u5230\u8fbe\u7b2c $3$ \u4e2a\u5730\u94c1\u7ad9\u540e\u8d70\u56de\u7ad9\u5385\uff0c\u518d\u8d70\u5230\u7b2c $3$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\uff0c\u4e58\u5750\u7b2c $3$ \u6761\u7ebf\u8def\u5230\u8fbe\u7b2c $6$ \u4e2a\u5730\u94c1\u7ad9\u540e\u8d70\u56de\u7ad9\u5385\uff0c\u6700\u540e\u8d70\u5230\u7b2c $6$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\uff0c\u603b\u6b65\u884c\u65f6\u95f4\u4e3a\n\n$$\nw_1+t_{1,1}+(t_{1,2}+t_{2,1})+(t_{2,2}+t_{3,1})+t_{3,4}+w_6=35.\n$$\n\n\u5bf9\u4e8e\u7b2c $2$ \u4e2a\u51fa\u884c\u8ba1\u5212\uff0c\u5c0f R \u5c06\u4ece\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\u524d\u5f80\u7b2c $3$ \u4e2a\u5730\u94c1\u7ad9\uff1a\u4ed6\u53ef\u4ee5\u5148\u4ece\u7b2c $2$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\u8d70\u5230\u7ad9\u5385\uff0c\u518d\u8d70\u5230\u7b2c $2$ \u6761\u7ebf\u8def\u7684\u7ad9\u53f0\uff0c\u4e58\u5750\u7b2c $2$ \u6761\u7ebf\u8def\u5230\u8fbe\u7b2c $3$ \u4e2a\u5730\u94c1\u7ad9\u540e\u8d70\u56de\u7ad9\u5385\uff0c\u6700\u540e\u8d70\u5230\u7b2c $3$ \u4e2a\u5730\u94c1\u7ad9\u7684\u5730\u94c1\u53e3\uff0c\u603b\u6b65\u884c\u65f6\u95f4\u4e3a\n\n$$\nw_2+t_{2,1}+t_{2,2}+w_3=16.\n$$\n\n### \u6837\u4f8b 3\n\n\u89c1\u9898\u76ee\u76ee\u5f55\u4e0b\u7684 `subway\/3.in` \u4e0e `subway\/3.ans`\u3002\n\n\u8be5\u6837\u4f8b\u6ee1\u8db3\u6d4b\u8bd5\u70b9 $4 \\sim 6$ \u7684\u7ea6\u675f\u6761\u4ef6\u3002\n\n### \u6837\u4f8b 4\n\n\u89c1\u9898\u76ee\u76ee\u5f55\u4e0b\u7684 `subway\/4.in` \u4e0e `subway\/4.ans`\u3002\n\n\u8be5\u6837\u4f8b\u6ee1\u8db3\u6d4b\u8bd5\u70b9 $9 \\sim 11$ \u7684\u7ea6\u675f\u6761\u4ef6\u3002\n\n### \u6837\u4f8b 5\n\n\u89c1\u9898\u76ee\u76ee\u5f55\u4e0b\u7684 `subway\/5.in` \u4e0e `subway\/5.ans`\u3002\n\n\u8be5\u6837\u4f8b\u6ee1\u8db3\u6d4b\u8bd5\u70b9 $12 \\sim 15$ \u7684\u7ea6\u675f\u6761\u4ef6\u3002\n\n### \u6837\u4f8b 6\n\n\u89c1\u9898\u76ee\u76ee\u5f55\u4e0b\u7684 `subway\/6.in` \u4e0e `subway\/6.ans`\u3002\n\n\u8be5\u6837\u4f8b\u6ee1\u8db3\u6d4b\u8bd5\u70b9 $16 \\sim 19$ \u7684\u7ea6\u675f\u6761\u4ef6\u3002\n\n### \u6837\u4f8b 7\n\n\u89c1\u9898\u76ee\u76ee\u5f55\u4e0b\u7684 `subway\/7.in` \u4e0e `subway\/7.ans`\u3002\n\n\u8be5\u6837\u4f8b\u6ee1\u8db3\u6d4b\u8bd5\u70b9 $22,23$ \u7684\u7ea6\u675f\u6761\u4ef6\u3002\n\n### \u6570\u636e\u8303\u56f4\n\n\u5bf9\u4e8e\u6240\u6709\u6d4b\u8bd5\u6570\u636e\uff0c\u5747\u6709\uff1a\n\n- $0 \\le c \\le 25$\uff0c$1 \\le n \\le 500$\uff0c$1 \\le m \\le \\sum_{i=1}^{n} k_i \\le 5 \\times 10^5$\uff0c$1 \\le d \\le 20$\uff0c$1 \\le q \\le 10^5$\uff1b\n- \u5bf9\u4e8e\u6240\u6709 $v$\uff08$1 \\le v \\le m$\uff09\uff0c\u5747\u6709 $1 \\le w_v \\le 10^9$\uff1b\n- \u5bf9\u4e8e\u6240\u6709 $i$\uff08$1 \\le i \\le n$\uff09\uff0c\u5747\u6709 $1 \\le k_i \\le m$\uff1b\n- \u5bf9\u4e8e\u6240\u6709 $i,j$\uff08$1 \\le i \\le n$\uff0c$1 \\le j \\le k_i$\uff09\uff0c\u5747\u6709 $1 \\le a_{i,j} \\le m$\uff0c$1 \\le t_{i,j} \\le 10^9$\uff1b\n- \u5bf9\u4e8e\u6240\u6709 $i$\uff08$1 \\le i \\le n$\uff09\uff0c\u5747\u6709 $a_{i,1},a_{i,2},\\ldots,a_{i,k_i}$ \u4e24\u4e24\u4e0d\u540c\uff1b\n- \u5bf9\u4e8e\u6240\u6709 $v$\uff08$1 \\le v \\le m$\uff09\uff0c\u7ecf\u8fc7\u7b2c $v$ \u4e2a\u5730\u94c1\u7ad9\u7684\u7ebf\u8def\u6570\u5747\u4e0d\u8d85\u8fc7 $d$\uff1b\n- \u4efb\u610f\u4e24\u4e2a\u5730\u94c1\u7ad9\u90fd\u53ef\u4ee5\u901a\u8fc7\u82e5\u5e72\u6761\u7ebf\u8def\u4e92\u76f8\u5230\u8fbe\uff1b\n- \u5bf9\u4e8e\u6240\u6709 $r$\uff08$1 \\le r \\le q$\uff09\uff0c\u5747\u6709 $1 \\le x_r,y_r \\le m$\uff0c\u4e14 $x_r \\ne y_r$\u3002\n\n::cute-table{tuack}\n| \u6d4b\u8bd5\u70b9\u7f16\u53f7 | $n \\le$ | $\\sum_{i=1}^{n} k_i \\le$ | $d \\le$ | $q \\le$ | \u7279\u6b8a\u6027\u8d28 |\n| :---: | :---: | :---: | :---: | :---: | :---: |\n| $1 \\sim 3$ | $3$ | $10$ | $20$ | $10$ | \u65e0 |\n| $4 \\sim 6$ | $50$ | $300$ | ^ | $200$ | \u65e0 |\n| $7,8$ | $200$ | $400$ | ^ | ^ | A |\n| $9 \\sim 11$ | $500$ | $1000$ | ^| $10^5$ | ^ |\n| $12 \\sim 15$ | ^ | $2 \\times 10^4$ | ^ | $2000$ | B |\n| $16 \\sim 19$ | ^ | $5 \\times 10^5$ | ^ | $10^5$ | ^ |\n| $20,21$ | $2$ | ^ | ^| ^ | \u65e0 |\n| $22,23$ | $500$ | ^ | $2$ | ^ | ^ |\n| $24,25$ | ^ | ^ | $20$ | ^ | ^ |\n\n\u7279\u6b8a\u6027\u8d28 A\uff1a\u6bcf\u6761\u7ebf\u8def\u81f3\u591a\u7ecf\u8fc7 $2$ \u4e2a\u5730\u94c1\u7ad9\uff0c\u5373\u5bf9\u4e8e\u6240\u6709 $i$\uff08$1 \\le i \\le n$\uff09\uff0c\u5747\u6709 $k_i \\le 2$\u3002\n\n\u7279\u6b8a\u6027\u8d28 B\uff1a\u5bf9\u4e8e\u6240\u6709\u7ebf\u8def\u7ecf\u8fc7\u7684\u6240\u6709\u5730\u94c1\u7ad9\uff0c\u4ece\u7ad9\u5385\u8d70\u5230\u5bf9\u5e94\u7ebf\u8def\u7ad9\u53f0\u7684\u6b65\u884c\u65f6\u95f4\u90fd\u76f8\u540c\uff0c\u5373\u5b58\u5728\u6b63\u6574\u6570 $T$\uff0c\u4f7f\u5f97\u5bf9\u4e8e\u6240\u6709 $i,j$\uff08$1 \\le i \\le n$\uff0c$1 \\le j \\le k_i$\uff09\uff0c\u5747\u6709 $t_{i,j}=T$\u3002","locale":"zh-CN"}},"bookmarked":false,"contest":null,"contestProblems":null,"contestOrigin":{"id":369912,"startTime":1793444400,"endTime":1794304800,"name":"CSP-S 2026 \u81ea\u6d4b\uff08\u6c11\u95f4\u6570\u636e\uff09"},"vjudgeUsername":null,"lastLanguage":null,"lastCode":"","lastCodeAt":null,"recommendations":[],"forum":{"name":"P17832 [CSP-S 2026] \u5730\u9