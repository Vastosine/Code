{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "clang++.exe - 生成和调试活动文件",
            "type": "cppdbg",
            "request": "launch",
            // "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "program": "${workspaceRoot}/run.exe",
            "args": [
                "<",
                "${workspaceFolder}/IO/in.in",
                ">",
                "${workspaceFolder}/IO/out.out"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: clang++.exe 生成活动文件"
        },
        {
            // 先执行“调试构建”任务，生成 run_dbg.exe 再启动调试。
            // STL 越界会在断言处停下；-ftrapv 的有符号溢出会以信号形式停下。
            "name": "clang++.exe - 调试构建（STL 越界检查）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/run_dbg.exe",
            "args": [
                "<",
                "${workspaceFolder}/IO/in.in",
                ">",
                "${workspaceFolder}/IO/out.out"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: 调试构建（STL 越界 + 溢出检查）"
        },
        {
            // launch.json 只能启动“可调试程序”，这里用 cmd.exe 包一层来跑对拍脚本。
            // 调试控制台会吞掉子进程的换行（输出挤成一行），所以改用独立控制台窗口；
            // stress_run.cmd 跑完会 pause，窗口不会一闪而过。
            "name": "对拍（stress，独立窗口）",
            "type": "cppdbg",
            "request": "launch",
            "program": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/c",
                "D:\\code\\stress\\stress_run.cmd",
                "-Sol",
                "${file}",
                "-N",
                "200"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}