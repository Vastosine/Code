{
    // ============================================================
    // 说明：当前工具链 D:\programs\OI\mingw64 没有编译 sanitizer 运行时，
    // 加 -fsanitize=address,undefined 会在链接阶段报 "cannot find -lasan"。
    // 所以日常查错用下面第 2 个任务（libstdc++ 自带检查 + 溢出陷阱）。
    // 以后装了 MSYS2 UCRT64（自带 libasan/libubsan），把该任务里
    // 注释掉的那行 -fsanitize=address,undefined 打开即可。
    // ============================================================
    "version": "2.0.0",
    "tasks": [
        {
            // 注意：label 不要改，launch.json 的 preLaunchTask 依赖它
            "label": "C/C++: clang++.exe 生成活动文件",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "${file}",
                "-o",
                // "${fileDirname}/${fileBasenameNoExtension}.exe",
                "${workspaceFolder}\\run.exe",
                "-Wshadow",
                "-DLOCAL",
                "-Wall",
                "-Wextra",
                "-std=c++20",
                "-ftemplate-depth=1000000"
                // "-O3"
                // "-I/media/yuxinhao/data/code/programs/CP-template",
                // "-I${workspaceFolder}/programs/CP-template"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "正常构建（F5 默认用这个），输出 run.exe"
        },
        {
            "label": "C/C++: 调试构建（STL 越界 + 溢出检查）",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}\\run_dbg.exe",
                "-Wshadow",
                "-Wextra",
                "-DLOCAL",
                "-std=c++20",
                "-O0",
                "-D_GLIBCXX_DEBUG",
                "-D_GLIBCXX_ASSERTIONS",
                "-ftrapv",
                "-Wall",
                "-ftemplate-depth=1000000",
                // 装了 MSYS2 UCRT64 之后，把下面这行注释打开：
                // "-fsanitize=address,undefined"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "vector/string 等 STL 越界或迭代器失效会当场 abort 并指出下标；有符号整数溢出会直接崩溃（exit 0xC000001D 或 3），崩溃本身就是报错"
        },
        {
            "label": "C/C++: 快速构建（-O2，对拍 / 测时限用）",
            "type": "shell",
            "command": "clang++",
            "args": [
                "${file}",
                "-o",
                "${workspaceFolder}\\run_fast.exe",
                "-DLOCAL",
                "-std=c++20",
                "-O2",
                "-ftemplate-depth=1000000"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "不开任何检查、开满优化，用来测真实耗时或和暴力程序对拍"
        },
        {
            // gen.cpp / brute.cpp 固定从 D:\code\stress 读取；sol 用当前打开的文件
            "label": "对拍：当前文件",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "D:\\code\\stress\\stress.ps1",
                "-Sol",
                "${file}",
                "-N",
                "300"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "随机对拍 300 组；gen/brute 取自 D:\\code\\stress，失败时打印可复现的 seed"
        },
        {
            // 运行时会弹框让你填被测文件名（相对当前文件所在目录），无需打开那个文件
            "label": "对拍：指定被测文件名",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "D:\\code\\stress\\stress.ps1",
                "-Sol",
                "${input:solFile}",
                "-N",
                "300"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "弹框输入文件名（如 a.cpp 或 a）；gen/brute 仍取自 D:\\code\\stress"
        }
    ],
    "inputs": [
        {
            "id": "solFile",
            "type": "promptString",
            "description": "被测文件名（相对当前目录，可省略 .cpp）",
            "default": "sol.cpp"
        }
    ]
}
